# Copy to .env and fill in. Node reads this file itself — there is no dotenv
# package — and .env is gitignored, so nothing here reaches the repository.
#
#   cp .env.example .env

# Required to use /admin.html at all. Unset means the admin API answers 404 on
# every route rather than being open, so this is the one line you must set.
# Generate one:   openssl rand -hex 24
ADMIN_TOKEN=

# Unset means no third-party script loads and no advertising cookie is set.
META_PIXEL_ID=

# First-party page and product counters. ANALYTICS=off stops collection.
# ANALYTICS=on

# Where a placed order is announced — one HTTPS POST. Point it at Zapier, Make,
# n8n, a WhatsApp provider, or your own script. Unset means nobody is told an
# order arrived, and the admin page marks those orders "unannounced".
ORDER_WEBHOOK_URL=
ORDER_WEBHOOK_SECRET=

# PORT=4000

# Firebase Analytics (Google Analytics 4). Print yours with:
#   firebase apps:sdkconfig WEB
# Unset means the SDK is never fetched and no Google cookie is set.
FIREBASE_WEB_CONFIG=
